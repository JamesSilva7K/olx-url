{
  "version": 2,
  "functions": {
    "api/index.py": {
      "maxDuration": 15
    }
  },
  "rewrites": [
    {
      "source": "/static/(.*)",
      "destination": "/static/$1"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py?__vpath__=/api/$1"
    },
    {
      "source": "/api",
      "destination": "/api/index.py?__vpath__=/api"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/api/index.py?__vpath__=/$1"
    }
  ]
}

